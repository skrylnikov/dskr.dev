{
  "name": "dskr.dev",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "test": "echo \"Error: no test specified\" && exit 1",
    "typesafe-i18n": "typesafe-i18n",
    "indie:dev": "tsx watch services/indie/src/server.ts",
    "indie:build": "tsc -p services/indie/tsconfig.json",
    "indie:migrate": "tsx services/indie/src/migrate.ts",
    "indie:test": "tsx --test services/indie/src/*.test.ts"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.x",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "download"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skrylnikov/dskr.dev.git"
  },
  "author": "Dmitry Skrylnikov",
