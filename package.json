{
  "name": "dskr.dev",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "astro dev",
    "admin:dev": "node --env-file-if-exists=.env --import tsx services/admin/server.ts",
    "admin:check": "tsc -p services/admin/tsconfig.json",
    "admin:build": "vite build --config services/admin/vite.config.ts",
    "admin:test": "node --import tsx --test services/admin/tests/*.test.mts",
    "admin:e2e": "playwright test --config services/admin/playwright.config.ts",
    "build": "astro build",
    "test": "astro build && node --import tsx --test src/data/projects.test.ts src/pages/_projects.test.ts src/pages/_travel.test.ts tests/travel/*.test.mts",
    "travel:test": "node --import tsx --test tests/travel/*.test.mts",
    "travel:fixtures": "node --import tsx tests/travel/fixtures.mts",
    "travel:e2e": "playwright test",
    "travel:import": "node --import tsx scripts/travel-import.mts",
    "travel:media": "node --env-file-if-exists=.env --import tsx scripts/travel-media.mts",
    "typesafe-i18n": "typesafe-i18n",
    "indie:dev": "tsx watch services/indie/src/server.ts",
    "indie:build": "tsc -p services/indie/tsconfig.json",
    "indie:migrate": "tsx services/indie/src/migrate.ts",
    "indie:test": "tsx --test services/indie/src/*.test.ts"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "download"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skrylnikov/dskr.dev.git"
  },
  "author": "Dmitry Skrylnikov",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/skrylnikov/dskr.dev/issues"
  },
  "homepage": "https://github.com/skrylnikov/dskr.dev#readme",
  "devDependencies": {
    "@astrojs/markdown-remark": "7.3.4",
    "@astrojs/mdx": "8.1.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@fastify/multipart": "10.1.6",
    "@mantine/core": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "@mantine/tiptap": "9.7.4",
    "@playwright/test": "1.64.1",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-code-block": "3.32.0",
    "@tiptap/extension-details": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "astro": "7.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-external-links": "3.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "vite": "8.3.5",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/formbody": "9.0.1",
    "date-fns": "4.4.0",
    "fastify": "5.12.7",
    "glightbox": "3.3.1",
    "highlight.js": "11.12.0",
    "linkedom": "0.18.14",
    "markdown-it": "15.0.3",
    "pg": "8.23.1",
    "remeda": "2.54.1",
    "s3mini": "1.0.3",
    "sharp": "0.35.5",
    "typesafe-i18n": "^5.27.1"
  }
}
