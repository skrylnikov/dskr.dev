# Append these settings to the ignored .env; never put real keys in this example.
MEDIA_S3_ENDPOINT=https://rustfs.home.dskr.dev
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ORIGINALS_BUCKET=dskr-media-originals
MEDIA_S3_PUBLISHED_BUCKET=dskr-media-published
MEDIA_S3_ACCESS_KEY_ID=REPLACE_WITH_UPLOADER_ACCESS_KEY
MEDIA_S3_SECRET_ACCESS_KEY=REPLACE_WITH_UPLOADER_SECRET

# The gateway uses these same MEDIA_S3 credentials via an encrypted infrastructure Secret.
