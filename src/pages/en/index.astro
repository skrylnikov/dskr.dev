---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import HCard from '../../components/HCard.astro';
import BlogPostPreview from '../../components/BlogPostPreview.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { projects } from '../../data/projects';
import { L } from '../../i18n/i18n-node';
import { absoluteUrl, AUTHOR_NAME, AUTHOR_URL, languageAlternates, SITE_META, SITE_TITLE, SOCIAL_PROFILES } from '../../consts';

const locale = Astro.currentLocale || 'en';
const LL = L[locale];
const metadata = SITE_META[locale];
const rssUrl = '/en/rss.xml';
const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: SITE_TITLE,
		url: absoluteUrl(Astro.url.pathname),
		inLanguage: locale,
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Person',
		name: AUTHOR_NAME,
		url: AUTHOR_URL,
		image: absoluteUrl('/img/me.jpeg'),
		sameAs: SOCIAL_PROFILES,
	},
];
const posts = (await getCollection('blogEn'))
	.filter((post) => !post.data.hidden)
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<SiteLayout title={metadata.title} description={metadata.description} alternates={languageAlternates('/')} structuredData={structuredData}>
	<section class="home-intro">
		<div class="intro-copy">
			<p class="eyebrow">{LL.home.eyebrow()}</p>
			<h1>{LL.home.title()}</h1>
			<p class="intro-lead">{LL.home.intro()}</p>
			<div class="intro-actions">
				<a class="button button--primary" href={getRelativeLocaleUrl(locale, '/about/')}>{LL.home.viewAbout()} <span aria-hidden="true">↗</span></a>
				<a class="button button--quiet" href={getRelativeLocaleUrl(locale, '/projects/')}>{LL.home.viewProjects()}</a>
			</div>
		</div>
		<HCard />
	</section>

	<section class="content-section h-feed" aria-labelledby="latest-heading">
		<div class="section-heading">
			<div>
				<p class="eyebrow">01 / {LL.nav.blog()}</p>
				<h2 id="latest-heading">{LL.home.latest()}</h2>
			</div>
			<a class="section-link" href={rssUrl}>RSS <span aria-hidden="true">↗</span></a>
		</div>
		<div class="post-grid">
			{posts.map((post, index) => (
				<BlogPostPreview
					title={post.data.title}
					description={post.data.description}
					publishDate={post.data.publishDate}
					slug={post.id}
					heroImage={post.data.heroImage}
					featured={index === 0}
				/>
			))}
		</div>
	</section>

	<section class="content-section projects-preview" aria-labelledby="projects-heading">
		<div class="section-heading">
			<div>
				<p class="eyebrow">02 / {LL.nav.projects()}</p>
				<h2 id="projects-heading">{LL.home.projects()}</h2>
			</div>
			<a class="section-link" href={getRelativeLocaleUrl(locale, '/projects/')}>{LL.home.viewProjects()} <span aria-hidden="true">↗</span></a>
		</div>
		<ul class="project-links">
			{projects.map((project) => {
				const copy = project[locale];
				return <li><a href={getRelativeLocaleUrl(locale, '/projects/') + `#${project.slug}`}>{copy.title} <span aria-hidden="true">↗</span></a><p>{copy.description}</p></li>;
			})}
		</ul>
	</section>
</SiteLayout>
