---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { L } from '../i18n/i18n-node';

const locale = Astro.currentLocale || 'ru';
const LL = L[locale];
const pathWithoutLocale = locale === 'en'
	? Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/'
	: Astro.url.pathname;
const changeLangUrl = getRelativeLocaleUrl(locale === 'en' ? 'ru' : 'en', pathWithoutLocale);
const isActive = (path: string) => Astro.url.pathname === getRelativeLocaleUrl(locale, path);
---

<header class="site-header">
	<div class="shell header-inner">
		<a class="brand" href={getRelativeLocaleUrl(locale, '/')} aria-label="Dskr.dev">
			<span>dskr</span><b>.dev</b>
		</a>

		<nav class="site-nav" aria-label={LL.nav.label()}>
			<a class:list={{ active: isActive('/') }} href={getRelativeLocaleUrl(locale, '/')}>{LL.nav.blog()}</a>
			<a class:list={{ active: isActive('/projects/') }} href={getRelativeLocaleUrl(locale, '/projects/')}>{LL.nav.projects()}</a>
			<a class:list={{ active: isActive('/about/') }} href={getRelativeLocaleUrl(locale, '/about/')}>{LL.nav.about()}</a>
		</nav>

		<div class="header-actions">
			<a class="language-switch" href={changeLangUrl} lang={locale === 'en' ? 'ru' : 'en'}>{LL.changeLang()}</a>
			<div class="theme-switch" role="group" aria-label={LL.theme.label()}>
				<button type="button" data-theme-option="light" aria-label={LL.theme.light()} title={LL.theme.light()}>☼</button>
				<button type="button" data-theme-option="system" aria-label={LL.theme.system()} title={LL.theme.system()}>◐</button>
				<button type="button" data-theme-option="dark" aria-label={LL.theme.dark()} title={LL.theme.dark()}>☾</button>
			</div>
		</div>
	</div>
</header>

<script is:inline>
	if (!window.__dskrThemeControls) {
		window.__dskrThemeControls = true;

		const syncThemeControls = () => {
			const selected = document.documentElement.dataset.theme || 'system';
			document.querySelectorAll('[data-theme-option]').forEach((button) => {
				button.setAttribute('aria-pressed', String(button.dataset.themeOption === selected));
			});
		};

		document.addEventListener('click', (event) => {
			const button = event.target.closest('[data-theme-option]');
			if (!button) return;
			document.documentElement.dataset.theme = button.dataset.themeOption;
			localStorage.setItem('dskr-theme', button.dataset.themeOption);
			syncThemeControls();
		});

		document.addEventListener('astro:after-swap', syncThemeControls);
		syncThemeControls();
	}
</script>
