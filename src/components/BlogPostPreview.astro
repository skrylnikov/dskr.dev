---
import { format } from 'date-fns';
import { ru } from 'date-fns/locale/ru';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { L } from '../i18n/i18n-node';
import { AUTHOR_NAME, AUTHOR_URL } from '../consts';

export interface Props {
	title: string;
	description: string;
	publishDate: Date;
	slug: string;
	heroImage?: string;
	featured?: boolean;
}

const { title, description, publishDate, slug, heroImage, featured = false } = Astro.props;
const LL = L[Astro.currentLocale];
const postUrl = getRelativeLocaleUrl(Astro.currentLocale || 'ru', `/blog/${slug}/`);
const fallbackArt: Record<string, { eyebrow: string; label: string; code: string }> = {
	'how-to-install-node': { eyebrow: 'RUNTIME', label: 'Node.js', code: 'fnm → corepack → pnpm' },
	'ts-nominal-type': { eyebrow: 'TYPESCRIPT', label: 'Nominal types', code: 'Lat / Lng · RUB / USD' },
};
const art = fallbackArt[slug] || { eyebrow: 'NOTEBOOK', label: 'A new experiment', code: 'ideas → code → shipped' };
---

<article class:list={['post-preview', 'h-entry', { featured }]}>
	<a class="preview-image-link u-url" href={postUrl} aria-label={title}>
		{heroImage ? (
			<img class="preview-image u-featured" src={heroImage} alt="" loading={featured ? 'eager' : 'lazy'} transition:name={`hero-${slug}`} />
		) : (
			<div class:list={['preview-art', `preview-art--${slug}`]} aria-hidden="true" transition:name={`hero-${slug}`}>
				<span class="art-eyebrow">{art.eyebrow}</span>
				<strong>{art.label}</strong>
				<code>{art.code}</code>
			</div>
		)}
	</a>
	<div class="preview-body">
		<p class="publish-date dt-published"><time datetime={publishDate.toISOString()}>{format(publishDate, 'd MMM yyyy', { locale: Astro.currentLocale === 'en' ? undefined : ru })}</time></p>
		<h2 class="title p-name"><a class="u-uid" href={postUrl}>{title}</a></h2>
		<p class="description p-summary">{description}</p>
		<span class="p-author h-card mf-author"><a class="p-name u-url" href={AUTHOR_URL}>{AUTHOR_NAME}</a></span>
		<a class="read" href={postUrl}>{LL.preview.readMore()} <span aria-hidden="true">↗</span></a>
	</div>
</article>
