---
import { render, type CollectionEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import TravelCollage from './TravelCollage.astro';
import MediaGallery from './MediaGallery.astro';
import { getTravelCatalog, getTravelMedia } from '../../lib/travel';
import { travelCopy, travelPath, entryAnchor, formatTravelDate, mediaSource } from '../../data/travel.mts';
import { absoluteUrl } from '../../consts';
import '../../styles/travel.css';
interface Props { trip: CollectionEntry<'trips'>; chapter?: CollectionEntry<'travelEntries'> }
const { trip, chapter } = Astro.props;
const { data } = trip;
const locale = data.locale;
const copy = travelCopy[locale];
const catalog = await getTravelCatalog();
const entries = catalog.entries.filter((entry) => entry.data.locale === locale && entry.data.trip === data.slug) as CollectionEntry<'travelEntries'>[];
const chapters = entries.filter((entry) => entry.data.kind === 'chapter');
const chapterIndex = chapter ? chapters.findIndex((entry) => entry.id === chapter.id) : -1;
const previous = chapters[chapterIndex - 1];
const next = chapter ? chapters[chapterIndex + 1] : undefined;
const current = chapter?.data.kind === 'chapter' ? chapter.data : data;
const { Content, headings } = await render(chapter ?? trip);
const notes = chapter ? [] : await Promise.all(entries.filter((entry) => entry.data.kind === 'note').map(async (entry) => ({ id: entry.id, ...await render(entry) })));
const targetLocale = locale === 'ru' ? 'en' : 'ru';
const translatedTrip = catalog.trips.find((t) => t.data.slug === data.slug && t.data.locale === targetLocale);
const translatedChapter = chapter && translatedTrip && catalog.entries.find((entry) => entry.data.kind === 'chapter' && entry.data.trip === data.slug && entry.data.slug === chapter.data.slug && entry.data.locale === targetLocale);
const languageSwitchUrl = translatedTrip && (!chapter || translatedChapter) ? travelPath(targetLocale, data.slug, translatedChapter?.data.slug) : travelPath(targetLocale);
const ownPath = travelPath(locale, data.slug, chapter?.data.slug);
const alternates = [{ hreflang: locale, href: absoluteUrl(ownPath) }, ...(translatedTrip && (!chapter || translatedChapter) ? [{ hreflang: targetLocale, href: absoluteUrl(languageSwitchUrl) }] : [])];
const image = mediaSource(getTravelMedia(current.collage[0]));
const toc = headings.filter((heading) => heading.depth === 2);
---
<SiteLayout title={`${current.title} — Dskr.dev`} description={current.description} {image} {alternates} {languageSwitchUrl} type={chapter ? 'article' : 'website'}>
	<nav class="travel-breadcrumbs" aria-label={locale === 'ru' ? 'Навигационная цепочка' : 'Breadcrumbs'}>
		<a href={travelPath(locale)}>{copy.title}</a><span aria-hidden="true">/</span>
		{chapter ? <><a href={travelPath(locale, data.slug)}>{data.title}</a><span aria-hidden="true">/</span><span aria-current="page">{current.title}</span></> : <span aria-current="page">{data.title}</span>}
	</nav>
	<article class="travel-story">
		<header class="travel-story-header">
			<p class="eyebrow">{data.destinations.join(' · ')}</p><h1>{current.title}</h1>
			<p class="travel-date">{chapter ? (chapter.data.date && <time datetime={chapter.data.date.toISOString()}>{formatTravelDate(chapter.data.date, locale)}</time>) : <><time datetime={data.startDate.toISOString()}>{formatTravelDate(data.startDate, locale)}</time>{data.endDate && <> — <time datetime={data.endDate.toISOString()}>{formatTravelDate(data.endDate, locale)}</time></>}</>}</p>
			<p class="intro-lead">{current.description}</p>
		</header>
		{!chapter && <TravelCollage refs={current.collage} eager />}
		{chapter && toc.length > 0 && <details class="travel-contents" open><summary>{copy.contents}</summary><ol>{toc.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></details>}
		<div class="travel-prose"><Content components={{ MediaGallery }} /></div>
		{!chapter && <>
			{chapters.length > 0 && <nav class="travel-contents" aria-label={copy.chapters}><p class="eyebrow">{copy.chapters}</p><ol>{chapters.map(({ data: entry }) => <li><a href={`#${entryAnchor(entry)}`}>{'title' in entry && entry.title}</a></li>)}</ol></nav>}
			<div class="travel-feed">{entries.map((entry) => {
				const item = entry.data;
				const NoteContent = notes.find((note) => note.id === entry.id)?.Content;
				return item.kind === 'chapter' ? <article id={entryAnchor(item)} class="travel-chapter-card">
					<a class="travel-card-link" href={travelPath(locale, data.slug, item.slug)}>
						<TravelCollage refs={item.collage} />
						<div class="travel-card-copy">{item.date && <p class="eyebrow"><time datetime={item.date.toISOString()}>{formatTravelDate(item.date, locale)}</time></p>}<h2>{item.title}</h2><p>{item.description}</p><span class="section-link">{copy.read} ↗</span></div>
					</a>
				</article> : <article id={entryAnchor(item)} class="travel-note">
					<header><a class="travel-note-permalink" href={`#${entryAnchor(item)}`} aria-label={copy.permalink}>{item.date ? <time datetime={item.date.toISOString()}>{formatTravelDate(item.date, locale)}</time> : copy.note} <span aria-hidden="true">#</span></a>{item.title && <h2>{item.title}</h2>}</header>
					<div class="travel-prose">{NoteContent && <NoteContent components={{ MediaGallery }} />}</div>
				</article>;
			})}</div>
		</>}
		{chapter && <nav class="travel-chapter-nav" aria-label={copy.chapters}>
			{previous && <a href={travelPath(locale, data.slug, previous.data.slug)}><span>{copy.previous}</span><strong>{previous.data.title}</strong></a>}
			<a href={`${travelPath(locale, data.slug)}#${entryAnchor(chapter.data)}`}>{copy.back}</a>
			{next && <a href={travelPath(locale, data.slug, next.data.slug)}><span>{copy.next}</span><strong>{next.data.title}</strong></a>}
		</nav>}
	</article>
</SiteLayout>
