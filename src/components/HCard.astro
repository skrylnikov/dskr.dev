---
import GithubSvg from './svg/github.astro';
import TelegramSvg from './svg/telegram.astro';
import InstagramSvg from './svg/instagram.astro';
import PlatformIcon from './svg/PlatformIcon.astro';
import XSvg from './svg/x.astro';
import { L } from '../i18n/i18n-node';

const LL = L[Astro.currentLocale];
---

<aside class="profile-card h-card">
	<div class="profile-card__top">
		<img class="u-photo" alt={LL.home.userName()} src="/img/me.jpeg" />
		<div class="profile-info">
			<p class="eyebrow">{LL.home.role()}</p>
			<h2 class="p-name">{LL.home.userName()}</h2>
			<p class="p-note">Dskr.dev</p>
		</div>
	</div>
	<ul class="social-links" aria-label="Social links">
		<li><a target="_blank" href="https://github.com/skrylnikov" rel="me noreferrer"><GithubSvg title="GitHub" /><span>GitHub</span></a></li>
		<li><a target="_blank" href="https://twitter.com/dskr_dev" rel="me noreferrer"><XSvg /><span>X</span></a></li>
		<li><a target="_blank" href="https://t.me/dskrylnikov" rel="me noreferrer"><TelegramSvg title="Telegram" /><span>Telegram</span></a></li>
		<li><a target="_blank" href="https://t.me/dskr_pic" rel="me noreferrer"><PlatformIcon name="photo" /><span>Фоточки</span></a></li>
		<li><a target="_blank" href="https://t.me/dskr_live" rel="me noreferrer"><PlatformIcon name="live" /><span>Live</span></a></li>
		<li><a target="_blank" href="https://www.instagram.com/dskr_dev" rel="me noreferrer"><InstagramSvg title="Instagram" /><span>Instagram</span></a></li>
		<li><a target="_blank" href="https://bsky.app/profile/dskr.bsky.social" rel="me noreferrer"><PlatformIcon name="bluesky" /><span>Bluesky</span></a></li>
		<li><a target="_blank" href="https://mastodon.ml/@dskr" rel="me noreferrer"><PlatformIcon name="mastodon" /><span>Mastodon</span></a></li>
		<li><a target="_blank" href="https://www.threads.com/@dskr_dev" rel="me noreferrer"><PlatformIcon name="threads" /><span>Threads</span></a></li>
		<li><a target="_blank" href="https://habr.com/ru/users/dsrk_dev/" rel="me noreferrer"><PlatformIcon name="habr" /><span>Habr</span></a></li>
	</ul>
	<div class="hidden">
		<a class="u-url u-uid" href="https://dskr.dev" rel="me">Blog</a>
		<a rel="me" href="https://ru.social/@dskr">Mastodon</a>
		<span class="p-nickname">dskr</span>
		<span class="p-sex">M</span>
	</div>
</aside>
