---
import { ClientRouter } from 'astro:transitions';

type PageType = 'website' | 'article';
type Alternate = { hreflang: string; href: string };
type StructuredData = Record<string, unknown> | Record<string, unknown>[];

export interface Props {
	title: string;
	description: string;
	image?: string;
	imageAlt?: string;
	type?: PageType;
	noindex?: boolean;
	publishedTime?: Date;
	modifiedTime?: Date;
	alternates?: Alternate[];
	structuredData?: StructuredData;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image, imageAlt, type = 'website', noindex, publishedTime, modifiedTime, alternates = [], structuredData } = Astro.props as Props;
const socialImage = image?.replace(/\.avif$/i, '.jpg') ?? '/img/me.jpeg';
const imageURL = new URL(socialImage, Astro.site);
const locale = Astro.currentLocale === 'en' ? 'en_US' : 'ru_RU';
const jsonLd = structuredData && JSON.stringify(structuredData).replace(/</g, '\\u003c');
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
<link rel="icon" type="image/x-icon" href="/img/me.jpeg" />
<meta name="generator" content={Astro.generator} />

<script is:inline>
	const theme = localStorage.getItem('dskr-theme');
	document.documentElement.dataset.theme = ['light', 'system', 'dark'].includes(theme) ? theme : 'system';

	document.addEventListener('astro:before-swap', (event) => {
		event.newDocument.documentElement.dataset.theme = document.documentElement.dataset.theme;
	});
</script>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
{alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex,follow" />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content="Dskr.dev" />
<meta property="og:locale" content={locale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content={imageAlt ?? title} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={imageAlt ?? title} />

<link rel="sitemap" href="/sitemap-index.xml" />

{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}

<!-- <link rel="authorization_endpoint" href="https://indieauth.com/auth"> -->

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.gstatic.com" />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono&family=IBM+Plex+Sans:wght@400;700&display=swap" />
<style is:global>
	@import "../styles/blog.css";
	@import "../styles/prism-vsc-dark-plus.css";
  
  
</style>

<ClientRouter />
