---
import type { CollectionEntry } from 'astro:content';
import { format } from 'date-fns';
import { ru } from 'date-fns/locale/ru';
import { L } from '../i18n/i18n-node';
import SiteLayout from './SiteLayout.astro';

type Props = CollectionEntry<'blog'>['data'] & { slug: string };

const { title, description, publishDate, heroImage, slug } = Astro.props;
const LL = L[Astro.currentLocale];
const github = `https://github.com/skrylnikov/dskr.dev/blob/master/src/content/blog/${slug}.mdx`;
---

<SiteLayout {title} {description} image={heroImage}>
	<div class="post-layout">
		<article class="post-content">
			<header class="post-header">
				<div class="post-meta">
					<p class="publish-date">{format(publishDate, 'd MMM yyyy', { locale: Astro.currentLocale === 'en' ? undefined : ru })}</p>
					<a target="_blank" href={github} rel="noreferrer">{LL.post.edit()}</a>
				</div>
				<h1>{title}</h1>
				{heroImage && <img class="post-hero-image" loading="eager" src={heroImage} alt={title} transition:name={`hero-${slug}`} />}
			</header>
			<main class="markdown-content">
				<slot />
			</main>
		</article>
	</div>
</SiteLayout>
